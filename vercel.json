{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/portfolio/:slug*", "destination": "/experiencias/", "permanent": true },
    { "source": "/portfolio-category/:slug*", "destination": "/experiencias/", "permanent": true },
    { "source": "/alojamentos", "destination": "https://alojamentos.paradisevillas.pt/", "permanent": false },
    { "source": "/contacts", "destination": "/contactos/", "permanent": true },
    { "source": "/homepage-2", "destination": "/", "permanent": true },
    { "source": "/homepage-3", "destination": "/", "permanent": true },
    { "source": "/erro", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(images|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
